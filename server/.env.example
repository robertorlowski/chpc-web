# Wzór server/.env (plik .env jest poza gitem). Na Render te same klucze ustawia się w Environment.
# Znaki specjalne w haśle kodować w adresie: ! -> %21, @ -> %40, : -> %3A, # -> %23.
MONGODB_URI=mongodb+srv://<użytkownik>:<hasło>@hp.e4k0pox.mongodb.net/hpdb?retryWrites=true&w=majority&appName=hp
API_KEY=
PORT=3001

# Konta użytkowników (2026-10-11)
# adres klienta (linki w mailach z kodem, usunięciem konta i zaproszeniem); kilka adresów po przecinku
CLIENT_URL=https://hpweb.onrender.com
# SMTP (Office 365); bez SMTP_HOST maile tylko w logu serwera
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# nadawca (bez „Send As” do niego mail idzie z SMTP_USER, odpowiedzi na MAIL_FROM)
MAIL_FROM=
# powiadomienia o nowych kontach
MAIL_ADMIN=
# hasło użytkownika systemowego (login „system” w polu e-mail); brak = logowanie systemowe wyłączone
SYSTEM_PASSWORD=
# właściciel sterowników sprzed kont (migracja jednorazowa przy starcie)
INITIAL_OWNER_EMAIL=robert@infotower.pl

# Powiadomienia Web Push (2026-10-21): klucze VAPID (raz: npx web-push generate-vapid-keys w server/);
# bez nich powiadomienia są wyłączone. VAPID_SUBJECT to mailto: administratora.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
